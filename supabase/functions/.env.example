# Baseten API key (default provider, OpenAI-compatible)
BASETEN_API_KEY=bt_sk_replace_me

# OpenCode Go API key (fallback / alternative provider, keep for backward compat)
OPENCODE_API_KEY=oc_sk_replace_me

# Optional: force a specific provider: "baseten" or "opencode"
# If unset, auto-selects Baseten when BASETEN_API_KEY is present, otherwise OpenCode.
# AI_PROVIDER=baseten
