# Gemini Developer API key (free tier). Edge Functions only — never expose via VITE_ vars.
# Used by companion-chat, game-ai-move and companion-news (gemini-3.5-flash-lite).
GEMINI_API_KEY=replace_me

# Optional: Tavily web search used when a companion chat message asks for news/search.
# TAVILY_API_KEY=replace_me

# Unsplash API access key (Edge Function only — never expose via VITE_ vars)
UNSPLASH_ACCESS_KEY=replace_me
