# Supabase project for the one-hour chat (Project Settings → API).
# Use the new sb_publishable_* key (legacy VITE_SUPABASE_ANON_KEY still
# works as a fallback).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Never put the Unsplash Access Key in a VITE_ variable; it belongs in the
# Supabase Edge Function secret UNSPLASH_ACCESS_KEY (see supabase/functions/.env.example).
