# Supabase project for the one-hour chat (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: official Unsplash random-photo API for the backdrop
# (unsplash.com → Developers → New application → Access Key).
# Without it, the keyless picsum.photos feed (Unsplash-sourced) is used.
# VITE_UNSPLASH_ACCESS_KEY=YOUR-UNSPLASH-ACCESS-KEY
